{
  "name": "live-counter-for-obs",
  "private": true,
  "type": "module",
  "version": "0.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --mode dock",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "vite build --mode dock && vite build --mode overlay && vite build --mode setup && node scripts/copy-font-licenses.mjs && node scripts/copy-static.mjs",
    "package": "node scripts/package-release.mjs",
    "pretest:ui": "npm run build",
    "test:ui": "playwright test",
    "shots:guide": "playwright test -c scripts/guide-shots/playwright.config.ts",
    "check:local": "node scripts/check-local.mjs",
    "check": "npm run typecheck && npm test && npm run check:local"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "fast-check": "^3.23.2",
    "typescript": "~5.6",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.21.1"
  }
}
